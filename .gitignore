# Unity3D generated meta files for folders that are ignored above are fine,
# but ignore crash reports and build artifacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
